import os
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    roc_auc_score,
    classification_report,
    confusion_matrix
)

OUTPUT_DIR = "../outputs/model_results"
os.makedirs(OUTPUT_DIR, exist_ok=True)

FEATURES = [
    "amount",
    "risk_score",
    "customer_txn_count",
    "amount_vs_customer_avg",
    "merchant_fraud_rate",
    "country_fraud_rate",
    "device_fraud_rate",
    "high_amount_flag"
]

df = pd.read_csv("../data/processed/transactions_features.csv")

X = df[FEATURES]
y = df["fraud_flag"]

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

model = RandomForestClassifier(
    n_estimators=200,
    random_state=42,
    n_jobs=-1
)

model.fit(X_train, y_train)

predictions = model.predict(X_test)
probabilities = model.predict_proba(X_test)[:, 1]

auc = roc_auc_score(y_test, probabilities)

# 1. Save model predictions
model_predictions = X_test.copy()
model_predictions["actual_fraud"] = y_test.values
model_predictions["fraud_probability"] = probabilities
model_predictions["predicted_fraud"] = predictions

model_predictions.to_csv(
    f"{OUTPUT_DIR}/model_predictions.csv",
    index=False
)

# 2. Save feature importance
feature_importance = pd.DataFrame({
    "feature": FEATURES,
    "importance": model.feature_importances_
}).sort_values("importance", ascending=False)

feature_importance.to_csv(
    f"{OUTPUT_DIR}/feature_importance.csv",
    index=False
)

# 3. Save classification report
report = classification_report(y_test, predictions)

with open(f"{OUTPUT_DIR}/classification_report.txt", "w") as f:
    f.write(f"ROC-AUC: {auc:.4f}\n\n")
    f.write(report)

# 4. Save confusion matrix
cm = confusion_matrix(y_test, predictions)

cm_df = pd.DataFrame(
    cm,
    columns=["Predicted Legit", "Predicted Fraud"],
    index=["Actual Legit", "Actual Fraud"]
)

cm_df.to_csv(f"{OUTPUT_DIR}/confusion_matrix.csv")

print("Model training complete.")
print(f"ROC-AUC: {auc:.4f}")
